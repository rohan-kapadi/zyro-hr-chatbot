# Google Gemini API Key (Required for LLM response generation)
GOOGLE_API_KEY=your_google_gemini_api_key_here

# LangSmith Tracing (Optional - set to true for debugging and prompt tracing)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT=zyro-rag-chatbot
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Custom HR Policies Directory Path (Optional - defaults to ./HR_Policies)
# HR_POLICIES_DIR=./HR_Policies
